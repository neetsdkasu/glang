'
' Ultimate tic-tac-toe
'

DIM FIELD1 ( 3 , 3 ) AS INTEGER
DIM FIELD2 ( 9 , 3 , 3 ) AS INTEGER

LET OFFSET = 20
LET CELL_SIZE = 40
LET AREA_R = -1
LET AREA_C = -1
LET PLAYER = 1
LET WINNER = 0
LET THINKING_TIME = 0
LET PLAY_COUNT = 0
LET WIN_PLAYER = 0
LET WIN_COMPUTER = 0
LET LAST_SELECT_CELL_R = -1
LET LAST_SELECT_CELL_C = -1
LET STEPS = 1

SUB NEW_GAME ( )
    STEPS = 1
    PLAY_COUNT += 1
    THINKING_TIME = 0
    AREA_R = -1
    AREA_C = -1
    PLAYER = 2 - PLAY_COUNT % 2
    WINNER = 0
    LAST_SELECT_CELL_R = -1
    LAST_SELECT_CELL_C = -1
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            FIELD1 ( R , C ) = 0
        END FOR
    END FOR
    FOR LET I = 0 TO 8
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                FIELD2 ( I , R , C ) = 0
            END FOR
        END FOR
    END FOR
END SUB

SUB DRAW_CROSS ( X AS INTEGER , Y AS INTEGER , S AS INTEGER )
    DRAWLINE X , Y , X + S , Y + S
    DRAWLINE X + S , Y , X , Y + S
END SUB

SUB STAMP_CROSS ( X AS INTEGER , Y AS INTEGER , S AS INTEGER )
    SETCOLOR 0 , 0 , 255
    FOR LET DY = -1 TO 1
        FOR LET DX = -1 TO 1
            CALL DRAW_CROSS ( X + DX , Y + DY , S )
        END FOR
    END FOR
END SUB

SUB STAMP_CIRCLE ( X AS INTEGER , Y AS INTEGER , S AS INTEGER )
    SETCOLOR 255 , 0 , 0
    FOR LET DY = -1 TO 1
        FOR LET DX = -1 TO 1
            DRAWARC X + DX , Y + DY , S , 0.0 , 360.0
        END FOR
    END FOR
END SUB

SUB DRAW_GAME ( )
    ' 盤面のクリア（TRANSFERだし不要では？
    ' SETCOLOR 255 , 255 , 255
    ' FILLRECT OFFSET , OFFSET , 9 * CELL_SIZE , 9 * CELL_SIZE
    ' 選択不能エリアを灰色で塗る
    IF AREA_R >= 0 THEN
        SETCOLOR 192 , 192 , 192
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF AREA_R != R || AREA_C != C THEN
                    FILLRECT OFFSET + C * 3 * CELL_SIZE , OFFSET + R * 3 * CELL_SIZE , 3 * CELL_SIZE , 3 * CELL_SIZE
                END IF
            END FOR
        END FOR
    END IF
    ' マルかバツかドローを描く
    FOR LET I = 0 TO 8
        LET RR = I \ 3
        LET CC = I % 3
        LET F1 = FIELD1 ( RR , CC )
        IF F1 == 0 || F1 == 3 THEN
            IF F1 == 3 THEN
                SETCOLOR 192 , 192 , 192
                FILLRECT OFFSET + CC * 3 * CELL_SIZE , OFFSET + RR * 3 * CELL_SIZE , 3 * CELL_SIZE , 3 * CELL_SIZE
            END IF
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    LET F2 = FIELD2 ( I , R , C )
                    IF F2 == 1 THEN
                        CALL STAMP_CROSS ( OFFSET + ( CC * 3 + C ) * CELL_SIZE + 3 , OFFSET + ( RR * 3 + R ) * CELL_SIZE + 3 , CELL_SIZE - 6 )
                    ELSE IF F2 == 2 THEN
                        CALL STAMP_CIRCLE ( OFFSET + ( CC * 3 + C ) * CELL_SIZE + 3 , OFFSET + ( RR * 3 + R ) * CELL_SIZE + 3 , CELL_SIZE - 6 )
                    END IF
                END FOR
            END FOR
        ELSE IF F1 == 1 THEN
            CALL STAMP_CROSS ( OFFSET + CC * 3 * CELL_SIZE + 5 , OFFSET + RR * 3 * CELL_SIZE + 5 , 3 * CELL_SIZE - 10 )
        ELSE IF F1 == 2 THEN
            CALL STAMP_CIRCLE ( OFFSET + CC * 3 * CELL_SIZE + 5 , OFFSET + RR * 3 * CELL_SIZE + 5, 3 * CELL_SIZE - 10 )
        END IF
    END FOR
    ' 直前の手の明示
    IF LAST_SELECT_CELL_R >= 0 THEN
        SETCOLOR 0 , 255 , 255
        DRAWRECT OFFSET + LAST_SELECT_CELL_C * CELL_SIZE + 2 , OFFSET + LAST_SELECT_CELL_R * CELL_SIZE + 2 , CELL_SIZE - 4 , CELL_SIZE - 4        
    END IF
    ' 盤面の格子線を描く
    SETCOLOR 127 , 127 , 127
    FOR LET R = 0 TO 9
        DRAWLINE OFFSET , OFFSET + R * CELL_SIZE , OFFSET + 9 * CELL_SIZE , OFFSET + R * CELL_SIZE
    END FOR
    FOR LET C = 0 TO 9
       DRAWLINE OFFSET + C * CELL_SIZE , OFFSET , OFFSET + C * CELL_SIZE , OFFSET + 9 * CELL_SIZE
    END FOR
    SETCOLOR 0 , 0 , 0
    FOR LET R = 3 TO 6 STEP 3
        DRAWLINE OFFSET , OFFSET + R * CELL_SIZE , OFFSET + 9 * CELL_SIZE , OFFSET + R * CELL_SIZE
    END FOR
    FOR LET C = 3 TO 6 STEP 3
       DRAWLINE OFFSET + C * CELL_SIZE , OFFSET , OFFSET + C * CELL_SIZE , OFFSET + 9 * CELL_SIZE
    END FOR
    ' テキスト系
    DRAWTEXT OFFSET + 10 * CELL_SIZE , OFFSET + 10 , "ULTIMATE TIC-TAC-TOE"
    DRAWTEXT OFFSET + 10 * CELL_SIZE + 20 , OFFSET + 80 , SEL ( PLAYER == 1 , "TURN: PLAYER" , "TURN: COMPUTER" )
    IF WINNER == 1 THEN
        SETCOLOR 0 , 0 , 255
        DRAWTEXT OFFSET + 10 * CELL_SIZE + 20 , OFFSET + 120 , "WINNER: PLAYER"
        SETCOLOR 0 , 0 , 0
    ELSE IF WINNER == 2 THEN
        SETCOLOR 255 , 0 , 0
        DRAWTEXT OFFSET + 10 * CELL_SIZE + 20 , OFFSET + 120 , "WINNER: COMPUTER"
        SETCOLOR 0 , 0 , 0
    ELSE IF WINNER == 3 THEN
        SETCOLOR 255 , 0 , 255
        DRAWTEXT OFFSET + 10 * CELL_SIZE + 20 , OFFSET + 120 , "DRAW"
        SETCOLOR 0 , 0 , 0
    END IF
    IF THINKING_TIME != 0 THEN
        SETCOLOR 100 , 100 , 100
        DRAWTEXT OFFSET + 10 * CELL_SIZE + 20 , OFFSET + 120 , "THINKING..."
        SETCOLOR 0 , 0 , 0
    END IF
    DRAWTEXT OFFSET + 10 * CELL_SIZE + 15 , OFFSET + 230 , "  PLAY COUNT: " + CSTR ( PLAY_COUNT )
    DRAWTEXT OFFSET + 10 * CELL_SIZE + 15 , OFFSET + 250 , "  PLAYER WON: " + CSTR ( WIN_PLAYER )
    DRAWTEXT OFFSET + 10 * CELL_SIZE + 15 , OFFSET + 270 , "COMPUTER WON: " + CSTR ( WIN_COMPUTER )
    ' NEW GAMEボタン
    DRAWRECT OFFSET + 10 * CELL_SIZE , OFFSET + 330 , 180 , 20
    DRAWTEXT OFFSET + 10 * CELL_SIZE + 55 , OFFSET + 332 , "NEW GAME"
END SUB

SUB SHOW_GAME ( )
    CALL DRAW_GAME ( )
    TRANSFER
END SUB

SUB JUDGE ( I AS INTEGER )
    LET RR = I \ 3
    LET CC = I % 3
    LET F = FIELD2 ( I , 1 , 1 )
    IF F != 0 THEN
        IF F == FIELD2 ( I , 0 , 0 ) && F == FIELD2 ( I , 2 , 2 ) THEN
            FIELD1 ( RR , CC ) = F
            RETURN
        ELSE IF F == FIELD2 ( I , 0 , 2 ) && F == FIELD2 ( I , 2 , 0 ) THEN
            FIELD1 ( RR , CC ) = F
            RETURN
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = FIELD2 ( I , A , 0 )
        IF F != 0 && F == FIELD2 ( I , A , 1 ) && F == FIELD2 ( I , A , 2 ) THEN
            FIELD1 ( RR , CC ) = F
            RETURN
        END IF
        F = FIELD2 ( I , 0 , A )
        IF F != 0 && F == FIELD2 ( I , 1 , A ) && F == FIELD2 ( I , 2 , A ) THEN
            FIELD1 ( RR , CC ) = F
            RETURN
        END IF
    END FOR
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            IF FIELD2 ( I , R , C ) == 0 THEn
                RETURN
            END IF
        END FOR
    END FOR
    FIELD1 ( RR , CC ) = 3
END SUB

SUB SET_LAST_SELECT ( I AS INTEGER , R AS INTEGER , C AS INTEGER )
    LET RR = I \ 3
    LET CC = I % 3
    IF FIELD1 ( RR , CC ) == 0 THEN
        LAST_SELECT_CELL_C = CC * 3 + C
        LAST_SELECT_CELL_R = RR * 3 + R
    ELSE
        LAST_SELECT_CELL_C = -1
        LAST_SELECT_CELL_R = -1
    END IF
END SUB

FUNC IS_DRAW ( ) AS BOOLEAN
    ' 0 1 2
    ' 3 4 5
    ' 6 7 8
    ' -> 001122334455667788
    ' none     0 ^ 0b11 -> 0b11
    ' player   1 ^ 0b11 -> 0b10
    ' computer 2 ^ 0b11 -> 0b01
    ' draw     3 ^ 0b11 -> 0b00
    LET F = 0
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            F = ( F << 2 ) | ( 0b11 ^ FIELD1 ( R , C ) )
        END FOR
    END FOR
    ' 0-1-2, 3-4-5, 6-7-8
    ' 001122334455667788
    '             ******
    '       ******
    ' ******
    ' 16141210 8 6 4 2 0
    IF ( ( F & ( F >> 2 ) & ( F >> 4 ) ) & 0b11000011000011 ) != 0 THEN
        RETURN FALSE
    END IF
    ' 0-3-6, 1-4-7, 2-5-8
    ' 001122334455667788
    '     **    **    **
    '   **    **    **
    ' **    **    **
    ' 16141210 8 6 4 2 0
    IF ( ( F & ( F >> 6 ) & ( F >> 12 ) ) & 0b111111 ) != 0 THEN
        RETURN FALSE
    END IF
    ' 0-4-8
    ' 001122334455667788
    ' **      **      **
    ' 16141210 8 6 4 2 0
    IF ( ( F & ( F >> 8 ) & ( F >> 16 ) ) & 0b11 ) != 0 THEN
        RETURN FALSE
    END IF
    ' 2-4-6
    ' 001122334455667788
    '     **  **  **
    ' 16141210 8 6 4 2 0
    IF ( ( ( F >> 4 )  & ( F >> 8 ) & ( F >> 12 ) ) & 0b11 ) != 0 THEN
        RETURN FALSE
    END IF
    RETURN TRUE
END FUNC

SUB CHANGE_TURN ( R AS INTEGER , C AS INTEGER )
    LET F = FIELD1 ( 1 , 1 )
    IF F != 0 && F != 3 THEN
        IF F == FIELD1 ( 0 , 0 ) && F == FIELD1 ( 2 , 2 ) THEN
            WINNER = PLAYER
        ELSE IF F == FIELD1 ( 0 , 2 ) && F == FIELD1 ( 2 , 0 ) THEN
            WINNER = PLAYER
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = FIELD1 ( A , 0 )
        IF F != 0 && F != 3 && F == FIELD1 ( A , 1 ) && F == FIELD1 ( A , 2 ) THEN
            WINNER = PLAYER
            BREAK
        END IF
        F = FIELD1 ( 0 , A )
        IF F != 0 && F != 3 && F == FIELD1 ( 1 , A ) && F == FIELD1 ( 2 , A ) THEN
            WINNER = PLAYER
            BREAK
        END IF
    END FOR
    LET COUNT = 0
    FOR LET RR = 0 TO 2
        FOR LET CC = 0 TO 2
            IF FIELD1 ( RR , CC ) == 0 THEN
                COUNT += 1
                BREAK
            END IF
        END FOR
    END FOR
    IF COUNT == 0 || IS_DRAW ( ) THEN
        WINNER = 3
    END IF
    IF WINNER != 0 THEN
        IF WINNER == 1 THEN
            WIN_PLAYER += 1
        ELSE IF WINNER == 2 THEN
            WIN_COMPUTER += 1
        END IF
        AREA_R = -1
        AREA_C = -1
        RETURN
    END IF
    STEPS += 1
    PLAYER = 3 - PLAYER
    IF FIELD1 ( R , C ) == 0 THEN
        AREA_R = R
        AREA_C = C
    ELSE
        AREA_R = -1
        AREA_C = -1
    END IF
END SUB

SUB PRINT_PUT_MARK ( I AS INTEGER , R AS INTEGER , C AS INTEGER )
    ' デバッグ用の中身表示処理
    ' ゲームの判定のどこかにバグがあるらしく、わからん
    PRINT "- - - - - - - - - - - - - - - - - - - - -"
    PRINT "GAME:" , PLAY_COUNT
    PRINT "STEPS:" , STEPS
    PRINT "PLAYER:" , PLAYER , " (" , SEL ( PLAYER == 1 , "P" , "C" ) , ")"
    PRINT "AREA_C:" , AREA_C , ", AREA_R:" , AREA_R
    PRINT "PUT ( I:" , I , ", R:" , R , ", C:" , C , " )"
    PRINT "FIELD1 ( I\3 , I%3 ):" , FIELD1 ( I \ 3 , I % 3 )
    PRINT "FIELD2 ( I , R , C ):" , FIELD2 ( I , R , C )
    FOR LET RR = 0 TO 8
        IF RR % 3 == 0 THEN
            PRINT "| -- -- -- | -- -- -- | -- -- --"
        END IF
        LET S = ""
        FOR LET CC = 0 TO 8
            IF CC % 3 == 0 THEN
                S += "| "
            END IF
            S += CSTR ( FIELD1 ( RR \ 3 , CC \ 3 ) ) + CSTR ( FIELD2 ( ( RR \ 3 ) * 3 + CC \ 3 , RR % 3 , CC % 3 ) )
            IF RR % 3 == R && CC % 3 == C && ( RR \ 3 ) * 3 + CC \ 3 == I THEN
                S += "<"
            ELSE
                S += " "
            END IF
        END FOR
        PRINT S
    END FOR
END SUB

SUB PUT_MARK ( I AS INTEGER , R AS INTEGER , C AS INTEGER )
    CALL PRINT_PUT_MARK ( I , R , C )
    FIELD2 ( I , R , C ) = PLAYER
    CALL JUDGE ( I )
    CALL SET_LAST_SELECT ( I , R , C )
    CALL CHANGE_TURN ( R , C )
END SUB

FUNC IN_RANGE ( V AS INTEGER , LB AS INTEGER , UB AS INTEGER ) AS BOOLEAN
    RETURN LB <= V && V < UB
END FUNC

FUNC IN_AREA ( X AS INTEGER , Y AS INTEGER , L AS INTEGER , T AS INTEGER , W AS INTEGER , H AS INTEGER ) AS BOOLEAN
    RETURN IN_RANGE ( X , L , L + W ) && IN_RANGE ( Y , T , T + H )
END FUNC

LET KEY_X = 0
LET KEY_Y = 0
LET KEY_KIND = 0
LET KEY_TIME = 0.0
LET LAST_KEY_TIME = 0.0

FUNC GET_INPUT ( ) AS BOOLEAN
    GETPOINTEREVENT KEY_X , KEY_Y , KEY_KIND , KEY_TIME
    IF KEY_KIND != 1 || KEY_TIME == LAST_KEY_TIME THEN
        RETURN FALSE
    END IF
    LAST_KEY_TIME = KEY_TIME
    KEY_X -= OFFSET
    KEY_Y -= OFFSET
    IF WINNER == 0 && PLAYER == 1 && IN_AREA ( KEY_X , KEY_Y , 0 , 0 , 9 * CELL_SIZE , 9 * CELL_SIZE ) THEN
        KEY_Y \= CELL_SIZE
        KEY_X \= CELL_SIZE
        LET RR = KEY_Y \ 3
        LET CC = KEY_X \ 3
        LET I = 3 * RR  + CC
        LET R = KEY_Y % 3
        LET C = KEY_X % 3
        IF AREA_C >= 0 THEN
            IF RR != AREA_R || CC != AREA_C || FIELD2 ( I , R , C ) != 0 THEN
                RETURN FALSE
            END IF
        ELSE IF FIELD1 ( RR , CC ) != 0 || FIELD2 ( I , R , C ) != 0 THEN
            RETURN FALSE
        END IF
        CALL PUT_MARK ( I , R , C )
        RETURN TRUE
    END IF
    IF IN_AREA ( KEY_X , KEY_Y , 10 * CELL_SIZE , 330 , 180 , 20 ) THEN
        IF WINNER == 0 THEN
            WIN_COMPUTER += 1
        END IF
        CALL NEW_GAME ( )
        RETURN TRUE
    END IF
    RETURN FALSE
END FUNC

SUB MAIN ( )
    RANDOMIZE
    SETFONTSIZE 16
    CALL NEW_GAME ( )
    CALL SHOW_GAME ( )
    DO WHILE TRUE
        IF GET_INPUT ( ) THEN
            CALL SHOW_GAME ( )
        ELSE IF WINNER == 0 && PLAYER != 1 THEN
            IF THINKING ( ) THEN
                CALL SHOW_GAME ( )
            END IF
        ELSE
            AWAIT 50        
        END IF
    END DO
END SUB

'
' コンピュータ側の思考について考える
'   [A1] 盤面の指定区画内から選ぶ
'       [B1] 区画を獲れる手がありそれを選ぶ
'           [C1] 区画を獲るとゲームで勝利
'           [C2] 区画を獲ると次の相手の番でゲームで勝利の手が確定（回避する必要がある）
'           [C3] 上記以外の予想困難（どちらかに必勝手順があったとしても計算大変すぎ）
'       [B2] 区画を獲れる手を選ばない、あるいは獲れる手がない
'           [D1] 選んだ手で次の相手の番でゲームで勝利の手が確定（回避する必要がある）
'           [D2] 上記以外の予想困難（どちらかに必勝手順があったとしても計算大変すぎ）
'   [A2] 盤面全体から選ぶ
'       [E1] 区画を獲れる手がありそれを選ぶ
'           [F1] 区画を獲るとゲームで勝利
'           [F2] 区画を獲ると次の相手の番でゲームで勝利の手が確定（回避する必要がある）
'           [F3] 上記以外の予想困難（どちらかに必勝手順があったとしても計算大変すぎ）
'       [E2] 区画を獲れる手を選ばない、あるいは獲れる手がない
'           [G1] 選んだ手で次の相手の番でゲームで勝利の手が確定（回避する必要がある）
'           [G2] 上記以外の予想困難（どちらかに必勝手順があったとしても計算大変すぎ）
' C1,F1は地道に計算する必要がある
' C3,D2,F3,G2はMCTSなど使うのが妥当かもだが面倒なのでランダム手
' C2,D1,F2,G1は回避手を除いて上記と同様の手の決定をすればいいが、回避手が無い場合（負け確）に注意する必要がある
' 回避手の判定は地味にめちゃ面倒
'

DIM COM_FIELD1 ( 3 , 3 ) AS INTEGER
DIM COM_FIELD2 ( 9 , 3 , 3 ) AS INTEGER
LET COM_AREA_R = -1
LET COM_AREA_C = -1
LET COM_PLAYER = 2
LET COM_WINNER = 0

SUB COPY_GAME_STATE ( )
    COM_AREA_R = AREA_R
    COM_AREA_C = AREA_C
    COM_PLAYER = PLAYER
    COM_WINNER = WINNER
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            COM_FIELD1 ( R , C ) = FIELD1 ( R , C )
        END FOR
    END FOR
    FOR LET I = 0 TO 8
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                COM_FIELD2 ( I , R , C ) = FIELD2 ( I , R , C )
            END FOR
        END FOR
    END FOR
END SUB

SUB COM_JUDGE ( I AS INTEGER )
    LET RR = I \ 3
    LET CC = I % 3
    LET F = COM_FIELD2 ( I , 1 , 1 )
    IF F != 0 THEN
        IF F == COM_FIELD2 ( I , 0 , 0 ) && F == COM_FIELD2 ( I , 2 , 2 ) THEN
            COM_FIELD1 ( RR , CC ) = F
            RETURN
        ELSE IF F == COM_FIELD2 ( I , 0 , 2 ) && F == COM_FIELD2 ( I , 2 , 0 ) THEN
            COM_FIELD1 ( RR , CC ) = F
            RETURN
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = COM_FIELD2 ( I , A , 0 )
        IF F != 0 && F == COM_FIELD2 ( I , A , 1 ) && F == COM_FIELD2 ( I , A , 2 ) THEN
            COM_FIELD1 ( RR , CC ) = F
            RETURN
        END IF
        F = COM_FIELD2 ( I , 0 , A )
        IF F != 0 && F == COM_FIELD2 ( I , 1 , A ) && F == COM_FIELD2 ( I , 2 , A ) THEN
            COM_FIELD1 ( RR , CC ) = F
            RETURN
        END IF
    END FOR
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            IF COM_FIELD2 ( I , R , C ) == 0 THEn
                RETURN
            END IF
        END FOR
    END FOR
    COM_FIELD1 ( RR , CC ) = 3
END SUB

SUB COM_CHANGE_TURN ( R AS INTEGER , C AS INTEGER )
    LET F = COM_FIELD1 ( 1 , 1 )
    IF F != 0 && F != 3 THEN
        IF F == COM_FIELD1 ( 0 , 0 ) && F == COM_FIELD1 ( 2 , 2 ) THEN
            COM_WINNER = COM_PLAYER
        ELSE IF F == COM_FIELD1 ( 0 , 2 ) && F == COM_FIELD1 ( 2 , 0 ) THEN
            COM_WINNER = COM_PLAYER
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = COM_FIELD1 ( A , 0 )
        IF F != 0 && F != 3 && F == COM_FIELD1 ( A , 1 ) && F == COM_FIELD1 ( A , 2 ) THEN
            COM_WINNER = COM_PLAYER
            BREAK
        END IF
        F = COM_FIELD1 ( 0 , A )
        IF F != 0 && F != 3 && F == COM_FIELD1 ( 1 , A ) && F == COM_FIELD1 ( 2 , A ) THEN
            COM_WINNER = COM_PLAYER
            BREAK
        END IF
    END FOR
    LET COUNT = 0
    FOR LET RR = 0 TO 2
        FOR LET CC = 0 TO 2
            IF COM_FIELD1 ( RR , CC ) == 0 THEN
                COUNT += 1
                BREAK
            END IF
        END FOR
    END FOR
    IF COUNT == 0 THEN
        COM_WINNER = 3
    END IF
    IF COM_WINNER != 0 THEN
        COM_AREA_R = -1
        COM_AREA_C = -1
        RETURN
    END IF
    COM_PLAYER = 3 - COM_PLAYER
    IF COM_FIELD1 ( R , C ) == 0 THEN
        COM_AREA_R = R
        COM_AREA_C = C
    ELSE
        COM_AREA_R = -1
        COM_AREA_C = -1
    END IF
END SUB

SUB COM_PUT_MARK ( I AS INTEGER , R AS INTEGER , C AS INTEGER )
    COM_FIELD2 ( I , R , C ) = COM_PLAYER
    CALL COM_JUDGE ( I )
    CALL COM_CHANGE_TURN ( R , C )
END SUB

FUNC THINKING ( ) AS BOOLEAN
    IF THINKING_TIME == 0 THEN
        CALL COPY_GAME_STATE ( )
        THINKING_TIME = 1
        RETURN TRUE
    END IF
    ' AWAIT 1000
    THINKING_TIME = 0
    IF STEPS == 1 THEN
        RETURN COM_PUT_RANDOM ( )
    END IF
    IF COM_AREA_R >= 0 THEN
        RETURN THINKING_A1 ( )
    ELSE
        RETURN THINKING_A2 ( )
    END IF
END FUNC

FUNC COM_IS_CHANCE ( R AS INTEGER , C AS INTEGER ) AS BOOLEAN
    IF COM_FIELD1 ( R , C ) != 0 THEN
        RETURN FALSE
    END IF
    COM_FIELD1 ( R , C ) = COM_PLAYER
    LET F = COM_FIELD1 ( 1 , 1 )
    IF F == COM_PLAYER THEN
        IF F == COM_FIELD1 ( 0 , 0 ) && F == COM_FIELD1 ( 2 , 2 ) THEN
            COM_FIELD1 ( R , C ) = 0
            RETURN TRUE
        ELSE IF F == COM_FIELD1 ( 0 , 2 ) && F == COM_FIELD1 ( 2 , 0 ) THEN
            COM_FIELD1 ( R , C ) = 0
            RETURN TRUE
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = COM_FIELD1 ( A , 0 )
        IF F == COM_PLAYER && F == COM_FIELD1 ( A , 1 ) && F == COM_FIELD1 ( A , 2 ) THEN
            COM_FIELD1 ( R , C ) = 0
            RETURN TRUE
        END IF
        F = COM_FIELD1 ( 0 , A )
        IF F == COM_PLAYER && F == COM_FIELD1 ( 1 , A ) && F == COM_FIELD1 ( 2 , A ) THEN
            COM_FIELD1 ( R , C ) = 0
            RETURN TRUE
        END IF
    END FOR
    COM_FIELD1 ( R , C ) = 0
    RETURN FALSE
END FUNC

FUNC COM_CAN_GET_AREA ( I AS INTEGER , R AS INTEGER , C AS INTEGER ) AS BOOLEAN
    IF COM_FIELD2 ( I , R , C ) != 0 THEN
        RETURN FALSE
    END IF
    COM_FIELD2 ( I , R , C ) = COM_PLAYER
    LET F = COM_FIELD2 ( I , 1 , 1 )
    IF F == COM_PLAYER THEN
        IF F == COM_FIELD2 ( I , 0 , 0 ) && F == COM_FIELD2 ( I , 2 , 2 ) THEN
            COM_FIELD2 ( I , R , C ) = 0
            RETURN TRUE
        ELSE IF F == COM_FIELD2 ( I , 0 , 2 ) && F == COM_FIELD2 ( I , 2 , 0 ) THEN
            COM_FIELD2 ( I , R , C ) = 0
            RETURN TRUE
        END IF
    END IF
    FOR LET A = 0 TO 2
        F = COM_FIELD2 ( I , 0 , A )
        IF F == COM_PLAYER && F == COM_FIELD2 ( I , 1 , A ) && F == COM_FIELD2 ( I , 2 , A ) THEN
            COM_FIELD2 ( I , R , C ) = 0
            RETURN TRUE
        END IF
        F = COM_FIELD2 ( I , A , 0 )
        IF F == COM_PLAYER && F == COM_FIELD2 ( I , A , 1 ) && F == COM_FIELD2 ( I , A , 2 ) THEN
            COM_FIELD2 ( I , R , C ) = 0
            RETURN TRUE
        END IF
    END FOR
    COM_FIELD2 ( I , R , C ) = 0
    RETURN FALSE
END FUNC

FUNC COM_CAN_WIN ( ) AS BOOLEAN
    IF COM_AREA_R >= 0 THEN
        LET I = COM_AREA_R * 3 + COM_AREA_C
        IF COM_IS_CHANCE ( COM_AREA_R , COM_AREA_C ) THEN
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    IF COM_CAN_GET_AREA ( I , R , C ) THEN
                        RETURN TRUE
                    END IF
                END FOR
            END FOR
        END IF
    ELSE
        FOR LET I = 0 TO 8
            IF COM_IS_CHANCE ( I \ 3 , I % 3 ) THEN
                FOR LET R = 0 TO 2
                    FOR LET C = 0 TO 2
                        IF COM_CAN_GET_AREA ( I , R , C ) THEN
                            RETURN TRUE
                        END IF
                    END FOR
                END FOR
            END IF
        END FOR
    END IF
    RETURN FALSE
END FUNC

FUNC THINKING_A1 ( ) AS BOOLEAN
    LET I = COM_AREA_R * 3 + COM_AREA_C
    IF COM_IS_CHANCE ( COM_AREA_R , COM_AREA_C ) THEN
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF COM_CAN_GET_AREA ( I , R , C ) THEN
                    CALL PUT_MARK ( I , R , C )
                    RETURN TRUE
                END IF
            END FOR
        END FOR
    END IF
    DIM STK ( 9 ) AS INTEGER
    LET CNT = 0
    FOR LET R = 0 TO 2
        FOR LET C = 0 TO 2
            IF COM_FIELD2 ( I , R , C ) != 0 THEN
                CONTINUE
            END IF
            CALL COM_PUT_MARK ( I , R , C )
            IF ! COM_CAN_WIN ( ) THEN
                STK ( CNT ) = R * 3 + C
                CNT += 1
            END IF
            CALL COPY_GAME_STATE ( )
        END FOR
    END FOR
    IF CNT > 1 THEN
        CALL HEAP_CLEAR ( )
        FOR LET J = 0 TO CNT - 1
            LET E = STK ( J )
            CALL HEAP_PUSH ( 2000000 + RANDOM ( ) % 100 , E )
        END FOR
        FOR LET Q = 0 TO 100
            LET K = HEAP_PEEK_KEY ( )
            LET E = HEAP_PEEK_ITEM ( )
            CALL HEAP_POP ( )
            LET R = E \ 3
            LET C = E % 3
            CALL COM_PUT_MARK ( I , R , C )
            CALL COM_SEARCH ( 5 )
            K += ( 2 * ( COM_WINNER % 3 ) - 3 ) * 500 - 1000
            CALL HEAP_PUSH ( K , E )
            CALL COPY_GAME_STATE ( )
        END FOR
        LET BEST_E = HEAP_PEEK_ITEM ( )
        CALL PUT_MARK ( I , BEST_E \ 3 , BEST_E % 3 )
        RETURN TRUE
    ELSE IF CNT == 1 THEN
        CNT = STK ( 0 )
        CALL PUT_MARK ( I , CNT \ 3 , CNT % 3 )
        RETURN TRUE
    END IF
    RETURN COM_PUT_RANDOM ( )
END FUNC

FUNC THINKING_A2 ( ) AS BOOLEAN
    FOR LET I = 0 TO 8
        IF COM_IS_CHANCE ( I \ 3 , I % 3 ) THEN
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    IF COM_CAN_GET_AREA ( I , R , C ) THEN
                        CALL PUT_MARK ( I , R , C )
                        RETURN TRUE
                    END IF
                END FOR
            END FOR
        END IF
    END FOR
    DIM STK ( 81 ) AS INTEGER
    LET CNT = 0
    FOR LET I = 0 TO 8
        IF COM_FIELD1 ( I \ 3 , I % 3 ) != 0 THEN
            CONTINUE
        END IF
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF COM_FIELD2 ( I , R , C ) != 0 THEN
                    CONTINUE
                END IF
                CALL COM_PUT_MARK ( I , R , C )
                IF ! COM_CAN_WIN ( ) THEN
                    STK ( CNT ) = I * 9 + R * 3 + C
                    CNT += 1
                END IF
                CALL COPY_GAME_STATE ( )
            END FOR
        END FOR
    END FOR
    IF CNT > 1 THEN
        CALL HEAP_CLEAR ( )
        FOR LET J = 0 TO CNT - 1
            LET E = STK ( J )
            CALL HEAP_PUSH ( 2000000 + RANDOM ( ) % 100 , E )
        END FOR
        FOR LET Q = 0 TO 100
            LET K = HEAP_PEEK_KEY ( )
            LET E = HEAP_PEEK_ITEM ( )
            CALL HEAP_POP ( )
            LET I = E \ 9
            LET R = ( E % 9 ) \ 3
            LET C = E % 3
            CALL COM_PUT_MARK ( I , R , C )
            CALL COM_SEARCH ( 5 )
            K += ( 2 * ( COM_WINNER % 3 ) - 3 ) * 500 - 1000
            CALL HEAP_PUSH ( K , E )
            CALL COPY_GAME_STATE ( )
        END FOR
        LET BEST_E = HEAP_PEEK_ITEM ( )
        CALL PUT_MARK ( BEST_E \ 9 , ( BEST_E % 9 ) \ 3 , BEST_E % 3 )
        RETURN TRUE
    ELSE IF CNT == 1 THEN
        CNT = STK ( 0 )
        CALL PUT_MARK ( CNT \ 9 , ( CNT % 9 ) \ 3 , CNT % 3 )
        RETURN TRUE
    END IF
    RETURN COM_PUT_RANDOM ( )
END FUNC

SUB COM_SEARCH ( D AS INTEGER ) 
    IF COM_CAN_WIN ( ) THEN
        COM_WINNER = COM_PLAYER
        RETURN
    ELSE IF COM_WINNER != 0 || D <= 0 THEN
        RETURN
    END IF
    DIM STK ( 81 ) AS INTEGER
    LET CNT = 0
    IF COM_AREA_C >= 0 THEN
        LET I = COM_AREA_R * 3 + COM_AREA_C
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF COM_FIELD2 ( I , R , C ) == 0 THEN
                    STK ( CNT ) = I * 9 + R * 3 + C
                    CNT += 1
                END IF
            END FOR
        END FOR
    ELSE
        FOR LET I = 0 TO 8
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    IF COM_FIELD2 ( I , R , C ) == 0 THEN
                        STK ( CNT ) = I * 9 + R * 3 + C
                        CNT += 1
                    END IF
                END FOR
            END FOR
        END FOR
    END IF
    IF CNT > 0 THEN
        CNT = STK ( RANDOM ( ) % CNT )
        CALL COM_PUT_MARK ( CNT \ 9 , ( CNT % 9 ) \ 3 , CNT % 3 )
        CALL COM_SEARCH ( D - 1 )
    END IF
END SUB

FUNC COM_PUT_RANDOM ( ) AS BOOLEAN
    LET COUNT = 0
    IF COM_AREA_C >= 0 THEN
        LET I = COM_AREA_R * 3 + COM_AREA_C
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF COM_FIELD2 ( I , R , C ) == 0 THEN
                    COUNT += 1
                END IF
            END FOR
        END FOR
        COUNT = RANDOM ( ) % COUNT
        FOR LET R = 0 TO 2
            FOR LET C = 0 TO 2
                IF COM_FIELD2 ( I , R , C ) == 0 THEN
                    IF COUNT == 0 THEN
                        CALL PUT_MARK ( I , R , C )
                        RETURN TRUE
                    END IF
                    COUNT -= 1
                END IF
            END FOR
        END FOR
    ELSE
        FOR LET I = 0 TO 8
            LET RR = I \ 3
            LET CC = I % 3
            IF COM_FIELD1 ( RR , CC ) != 0 THEN
                CONTINUE
            END IF
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    IF COM_FIELD2 ( I , R , C ) == 0 THEN
                        COUNT += 1
                    END IF
                END FOR
            END FOR
        END FOR
        COUNT = RANDOM ( ) % COUNT
        FOR LET I = 0 TO 8
            LET RR = I \ 3
            LET CC = I % 3
            IF COM_FIELD1 ( RR , CC ) != 0 THEN
                CONTINUE
            END IF
            FOR LET R = 0 TO 2
                FOR LET C = 0 TO 2
                    IF COM_FIELD2 ( I , R , C ) == 0 THEN
                        IF COUNT == 0 THEN
                            CALL PUT_MARK ( I , R , C )
                            RETURN TRUE
                        END IF
                        COUNT -= 1
                    END IF
                END FOR
            END FOR
        END FOR
    END IF
    RETURN FALSE
END FUNC

'
' 1-indexed array binary max heap
'
DIM HEAP_KEYS ( 100 ) AS INTEGER
DIM HEAP_ITEMS ( 100 ) AS INTEGER
LET HEAP_COUNT = 0

SUB HEAP_CLEAR ( )
    HEAP_COUNT = 0
END SUB

SUB HEAP_SWAP ( A AS INTEGER , B AS INTEGER )
    LET T = HEAP_KEYS ( A )
    HEAP_KEYS ( A ) = HEAP_KEYS ( B )
    HEAP_KEYS ( B ) = T
    T = HEAP_ITEMS ( A )
    HEAP_ITEMS ( A ) = HEAP_ITEMS ( B )
    HEAP_ITEMS ( B ) = T
END SUB

SUB HEAP_PUSH ( HEAP_KEY AS INTEGER , HEAP_ITEM AS INTEGER )
    HEAP_COUNT += 1
    HEAP_KEYS ( HEAP_COUNT ) = HEAP_KEY
    HEAP_ITEMS ( HEAP_COUNT ) = HEAP_ITEM
    LET E = HEAP_COUNT
    DO WHILE E > 1
        LET F = E >> 1
        IF HEAP_KEYS ( E ) > HEAP_KEYS ( F ) THEN
            CALL HEAP_SWAP ( E , F )
            E = F
        ELSE
            RETURN
        END IF
    END DO
END SUB

FUNC HEAP_PEEK_KEY ( ) AS INTEGER
    RETURN HEAP_KEYS ( 1 )
END FUNC

FUNC HEAP_PEEK_ITEM ( ) AS INTEGER
    RETURN HEAP_ITEMS ( 1 )
END FUNC

SUB HEAP_POP ( )
    HEAP_KEYS ( 1 ) = HEAP_KEYS ( HEAP_COUNT )
    HEAP_ITEMS ( 1 ) = HEAP_ITEMS ( HEAP_COUNT )
    HEAP_COUNT -= 1
    LET E = 1
    DO WHILE ( E << 1 ) <= HEAP_COUNT
        LET F = E << 1
        IF F < HEAP_COUNT THEN
            IF HEAP_KEYS ( F + 1 ) > HEAP_KEYS ( F ) THEN
                F += 1
            END IF
        END IF
        IF HEAP_KEYS ( F ) > HEAP_KEYS ( E ) THEN
            CALL HEAP_SWAP ( F , E )
            E = F
        ELSE
            RETURN
        END IF
    END DO
END SUB
